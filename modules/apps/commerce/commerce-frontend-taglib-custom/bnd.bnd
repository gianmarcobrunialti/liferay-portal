Bundle-Name: Commerce Frontend Taglib Custom
Bundle-SymbolicName: com.commerce.frontend.taglib.custom
Bundle-Version: 1.0.0
Export-Package: com.commerce.frontend.taglib.custom
Provide-Capability:\
  osgi.extender;\
    osgi.extender="jsp.taglib";\
    uri="http://liferay.com/tld/liferay-commerce-ui-custom";\
    version:Version="${Bundle-Version}"
Web-ContextPath: /commerce-frontend-taglib-custom
