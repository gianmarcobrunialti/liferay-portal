{
  "commerce-frontend-js": {
    "dest-mod-name-mapper": {
      "from": "(.*)\\.js$",
      "to": "bridge/commerce-frontend-taglib-custom/$1"
    },
    "file-globs": "**/*.js,**/*.soy.js",
    "input": "build/node/packageRunBuild/resources",
    "output": "build/node/packageRunBuild/resources/bridge/commerce-frontend-taglib-custom",
    "src-mod-name-mapper": {
      "from": "(.*)\\.js$",
      "to": "commerce-frontend-taglib-custom/$1"
    }
  }
}